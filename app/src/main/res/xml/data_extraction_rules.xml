<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ equivalent of backup_rules.xml (cloud backup + device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="kannada_learn.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kannada_learn.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
